# 복사해서 .env로 저장 후 값 채우기. .env는 git에 올리지 말 것 (chmod 600 권장)
# 외부 포트
PORT=10201
# 서빙할 호스트 폴더 -> 컨테이너 /data 통서빙
SHARED_FOLDER=/path/to/folder
# 단일 유저 Basic Auth (entrypoint가 htpasswd 생성, 평문은 이미지에 남지 않음)
# PASSWORD에 $가 있으면 $$ 로 적기 (compose가 $VAR로 치환해 버림. 실측: a$b123→a, a$$b123→a$b123)
USERNAME=
PASSWORD=
# 파일 소유자 (호스트 uid:gid, id -u/id -g로 확인)
PUID=1000
PGID=1000
